<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="using:StellarModManager.Services"
             xmlns:c="using:StellarModManager.Controls"
             xmlns:views="using:StellarModManager.Views"
             xmlns:vm="using:StellarModManager.ViewModels"
             xmlns:models="using:StellarModManager.Models"
             xmlns:loc="using:StellarModManager.Services"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="StellarModManager.Views.OnlineModsView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <Style Selector="ToggleButton.categoryFilter">
            <Setter Property="Width" Value="27"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondaryBrush}"/>
        </Style>
        <Style Selector="ToggleButton.categoryFilter:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceHoverBrush}"/>
        </Style>
        <Style Selector="ToggleButton.categoryInclude:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Theme.SuccessBrush}"/>
        </Style>
        <Style Selector="ToggleButton.categoryExclude:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Theme.DangerBrush}"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="CatalogOptionTemplate" x:DataType="x:String">
            <TextBlock>
                <TextBlock.Text>
                    <MultiBinding Converter="{x:Static views:OnlineModsView.CatalogOptionText}">
                        <Binding/>
                        <Binding Source="{x:Static loc:LocalizationService.Instance}" Path="CurrentLanguage"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="CategoryFiltersTemplate" x:DataType="vm:MainWindowViewModel">
            <ItemsControl ItemsSource="{Binding BrowseCategories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BrowseCategoryFilterViewModel">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="3" Margin="0,1">
                            <TextBlock x:Name="CategoryName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{x:Static views:OnlineModsView.CatalogOptionText}">
                                        <Binding Path="LabelKey"/>
                                        <Binding Source="{x:Static loc:LocalizationService.Instance}" Path="CurrentLanguage"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <ToggleButton Grid.Column="1" Classes="categoryFilter categoryInclude"
                                          IsChecked="{Binding IsIncluded, Mode=OneWay}" Command="{Binding ToggleIncludeCommand}"
                                          ToolTip.Tip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[BrowseCategoryInclude]}">
                                <AutomationProperties.Name>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Source="{x:Static loc:LocalizationService.Instance}" Path="[BrowseCategoryInclude]"/>
                                        <Binding Path="#CategoryName.Text"/>
                                    </MultiBinding>
                                </AutomationProperties.Name>
                                <PathIcon Width="13" Height="13" Data="M 2,7 L 5,10 L 11,4 L 12,5 L 5,12 L 1,8 Z"/>
                            </ToggleButton>
                            <ToggleButton Grid.Column="2" Classes="categoryFilter categoryExclude"
                                          IsChecked="{Binding IsExcluded, Mode=OneWay}" Command="{Binding ToggleExcludeCommand}"
                                          ToolTip.Tip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[BrowseCategoryExclude]}">
                                <AutomationProperties.Name>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Source="{x:Static loc:LocalizationService.Instance}" Path="[BrowseCategoryExclude]"/>
                                        <Binding Path="#CategoryName.Text"/>
                                    </MultiBinding>
                                </AutomationProperties.Name>
                                <PathIcon Width="13" Height="13" Data="F0 M 7,0 A 7,7 0 1 0 7,14 A 7,7 0 1 0 7,0 Z M 7,1.4 A 5.6,5.6 0 1 1 7,12.6 A 5.6,5.6 0 1 1 7,1.4 Z M 2.5,3.5 L 3.5,2.5 L 11.5,10.5 L 10.5,11.5 Z"/>
                            </ToggleButton>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="BrowseLayoutRoot" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto">
        <Grid Grid.Column="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Height="36"
              Margin="0,0,0,12">
            <TextBox x:Name="CatalogSearch" Padding="10,4,6,6"
                     AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CatalogSearchPlaceholder]}"
                     PlaceholderText="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CatalogSearchPlaceholder]}"
                     Text="{Binding SearchText}">
                <TextBox.InnerLeftContent>
                    <svg:Svg Css="{DynamicResource Theme.IconCss}" Path="/Assets/Icons/search.svg"
                             Width="16" Height="16" Margin="10,0,0,0"/>
                </TextBox.InnerLeftContent>
            </TextBox>

            <ComboBox Grid.Column="1" MinWidth="104" VerticalAlignment="Stretch" Padding="12,5,0,5"
                      SelectedIndex="{Binding BrowseTypeIndex, Mode=TwoWay}"
                      SelectionBoxItemTemplate="{StaticResource CatalogOptionTemplate}"
                      AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CatalogTypeLabel]}">
                <ComboBoxItem Content="CatalogMods" ContentTemplate="{StaticResource CatalogOptionTemplate}"
                              AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CatalogMods]}"/>
                <ComboBoxItem Content="CatalogPlugins" ContentTemplate="{StaticResource CatalogOptionTemplate}"
                              AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CatalogPlugins]}"/>
            </ComboBox>

            <ComboBox Grid.Column="2" MinWidth="150" VerticalAlignment="Stretch" Padding="12,5,0,5"
                      SelectedIndex="{Binding SortIndex}"
                      SelectionBoxItemTemplate="{StaticResource CatalogOptionTemplate}"
                      AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[SortLabel]}">
                <ComboBoxItem Content="SortRecentlyPublished" ContentTemplate="{StaticResource CatalogOptionTemplate}"
                              AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[SortRecentlyPublished]}"/>
                <ComboBoxItem Content="SortName" ContentTemplate="{StaticResource CatalogOptionTemplate}"
                              AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[SortName]}"/>
                <ComboBoxItem Content="SortMostDownloaded" ContentTemplate="{StaticResource CatalogOptionTemplate}"
                              AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[SortMostDownloaded]}"/>
            </ComboBox>

            <Border Grid.Column="3" Classes="segmented" VerticalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="ghost" Classes.selected="{Binding IsCompactView}" Height="30"
                            Command="{Binding ShowCompactViewCommand}"
                            AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ViewCompact]}"
                            ToolTip.Tip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ViewCompact]}">
                        <svg:Svg Css="{DynamicResource Theme.IconCss}" Path="/Assets/Icons/viewGrid.svg" Width="18" Height="18"/>
                    </Button>
                    <Button Classes="ghost" Classes.selected="{Binding !IsCompactView}" Height="30"
                            Command="{Binding ShowListViewCommand}"
                            AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ViewList]}"
                            ToolTip.Tip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ViewList]}">
                        <svg:Svg Css="{DynamicResource Theme.IconCss}" Path="/Assets/Icons/viewList.svg" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Border>

            <Button Grid.Column="4" Classes="subtle icon" Command="{Binding RefreshModsCommand}"
                    AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Refresh]}"
                    ToolTip.Tip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Refresh]}">
                <svg:Svg Css="{DynamicResource Theme.IconCss}" Path="/Assets/Icons/refresh.svg" Width="18" Height="18"/>
            </Button>
        </Grid>

        <ScrollViewer x:Name="BrowseSidebar" Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <Border x:Name="CategoryPanel" Padding="10"
                        Background="{DynamicResource Theme.SurfaceBrush}"
                        BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="sectionTitle"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[BrowseCategory]}"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CategoryFiltersTemplate}"/>
                    </StackPanel>
                </Border>
                <Button x:Name="CategoryMenu" Classes="subtle"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[BrowseCategory]}">
                    <Button.Flyout>
                        <Flyout>
                            <ContentControl MinWidth="184"
                                            Content="{Binding #CategoryMenu.((vm:MainWindowViewModel)DataContext)}"
                                            ContentTemplate="{StaticResource CategoryFiltersTemplate}"/>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="LibraryShortcut" Classes="subtle libraryShortcut"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Top"
                        ToolTip.Tip="{Binding LibraryShortcutText}"
                        Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Library}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="sectionTitle"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavLibrary]}"/>
                            <TextBlock Classes="secondary" Text="{Binding LibraryShortcutText}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Classes="accent" Text="→" VerticalAlignment="Center" FontSize="16"/>
                    </Grid>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto">

            <Grid Grid.Row="0" IsVisible="{Binding !IsCompactView}" ColumnDefinitions="60,*,70,80,110,120" Height="32" Margin="12,0">
                <TextBlock Grid.Column="1" Classes="columnHeader" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ColumnName]}"/>
                <TextBlock Grid.Column="2" Classes="columnHeader" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ColumnVersion]}"/>
                <TextBlock Grid.Column="3" Classes="columnHeader"
                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ColumnDownloads]}"
                           ToolTip.Tip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[UniqueDownloadsTooltip]}"/>
                <TextBlock Grid.Column="4" Classes="columnHeader" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ColumnPublished]}"/>
                <TextBlock Grid.Column="5" Classes="columnHeader" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ColumnState]}"/>
            </Grid>
            <Rectangle Grid.Row="0" Classes="separator" VerticalAlignment="Bottom" IsVisible="{Binding !IsCompactView}"/>

            <TextBlock Grid.Row="1" Classes="secondary" FontSize="14" Margin="12,16"
                       IsVisible="{Binding HasNoBrowseResults}"
                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NoCatalogResults]}"/>

            <ListBox x:Name="TableList" Grid.Row="1" Classes="table modItems"
                     BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Hidden" IsEnabled="{Binding !IsBrowseLoading}" IsVisible="{Binding !IsCompactView}"
                     Margin="0,4,0,0"
                     ItemsSource="{Binding VisibleOnlineMods}"
                     SelectedItem="{Binding BrowseSelection}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Height" Value="64"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:OnlineModInfo">
                        <Grid>
                            <Border Classes="pill"/>
                            <Grid ColumnDefinitions="60,*,70,80,110,120" Margin="12,0">
                                <Border Classes="thumbnail" Width="48" Height="48" HorizontalAlignment="Left">
                                    <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Theme.TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Classes="depWarn" IsVisible="{Binding HasCompatibilityWarning}"
                                                ToolTip.Tip="{Binding CompatibilityTooltip}" AutomationProperties.Name="{Binding CompatibilityWarning}">
                                            <TextBlock Text="!"/>
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="secondary" Text="{Binding Author}" MaxWidth="160" Margin="0,0,8,0"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding _Tags}"
                                                      Height="20" ClipToBounds="True" VerticalAlignment="Center"
                                                      IsVisible="{Binding _Tags.Count}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel ItemHeight="20"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:ModTag">
                                                    <Border Classes="tag" Margin="0,0,4,0" VerticalAlignment="Center"
                                                            Classes.assisted="{Binding IsAssisted}"
                                                            Classes.vibecoded="{Binding IsVibecoded}"
                                                            Classes.active="{Binding IsActive}"
                                                            Classes.inactive="{Binding IsInactive}">
                                                        <TextBlock Text="{Binding Text}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Classes="cell" Text="{Binding DisplayVersion}"/>
                                <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Downloads, StringFormat={}{0:N0}}"
                                           ToolTip.Tip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[UniqueDownloadsTooltip]}"/>
                                <TextBlock Grid.Column="4" Classes="cell" Text="{Binding PublishedText}"/>

                                <Panel Grid.Column="5" VerticalAlignment="Center">
                                    <TextBlock Classes="cell success" IsVisible="{Binding ShowInstalledState}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[StateInstalled]}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowUpdateState}">
                                        <TextBlock Classes="cell accent" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[StateUpdate]}"/>
                                        <TextBlock Classes="cell accent" Text="{Binding DisplayVersion}"/>
                                    </StackPanel>
                                    <TextBlock Classes="cell" Text="—" IsVisible="{Binding ShowNoState}"/>
                                    <StackPanel Spacing="6" IsVisible="{Binding IsInstalling}" Margin="0,0,16,0">
                                        <TextBlock Classes="cell" Text="{Binding DownloadProgress, StringFormat={}{0:0} %}"/>
                                        <ProgressBar Classes="modProgress" Minimum="0" Maximum="100" Value="{Binding DownloadProgress}"/>
                                    </StackPanel>
                                </Panel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- Compact view: card grid -->
            <ListBox x:Name="CardList" Grid.Row="1" Classes="cards modItems" IsEnabled="{Binding !IsBrowseLoading}"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     IsVisible="{Binding IsCompactView}"
                     ItemsSource="{Binding VisibleOnlineMods}"
                     SelectedItem="{Binding BrowseSelection}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <c:GridWrapPanel ItemWidth="{x:Static layout:BrowseLayout.MinimumCardWidth}" ItemHeight="{Binding CompactCardHeight}" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:OnlineModInfo">
                        <Grid RowDefinitions="Auto,Auto">
                            <Border CornerRadius="9,9,0,0"
                                    Height="{Binding $parent[views:OnlineModsView].((vm:MainWindowViewModel)DataContext).CompactImageHeight}">
                                <Border.Background>
                                    <ImageBrush Source="{Binding ThumbnailImage}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>

                            <Grid Grid.Row="1"
                                  Height="{Binding $parent[views:OnlineModsView].((vm:MainWindowViewModel)DataContext).CompactMetadataHeight}"
                                  RowDefinitions="*,Auto">
                                <StackPanel Margin="12,9,12,4" Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" Classes="depWarn" IsVisible="{Binding HasCompatibilityWarning}"
                                                ToolTip.Tip="{Binding CompatibilityTooltip}" AutomationProperties.Name="{Binding CompatibilityWarning}">
                                            <TextBlock Text="!"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Classes="secondary" Text="{Binding Author}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Classes="cardDescription" Text="{Binding Description, Converter={x:Static c:MarkdownText.Preview}}" Margin="0,3,0,2"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                                <ItemsControl ItemsSource="{Binding _Tags}" Height="20" ClipToBounds="True"
                                                  ToolTip.Tip="{Binding TagSummary}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ModTag">
                                                <Border Classes="tag" Margin="0,0,4,0"
                                                        Classes.assisted="{Binding IsAssisted}"
                                                        Classes.vibecoded="{Binding IsVibecoded}"
                                                        Classes.active="{Binding IsActive}"
                                                        Classes.inactive="{Binding IsInactive}">
                                                    <TextBlock Text="{Binding Text}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Border Grid.Row="1" Classes="cardFooter">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Classes="secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding DownloadsText}"
                                                   ToolTip.Tip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[UniqueDownloadsTooltip]}"/>
                                        <Panel Grid.Column="1" VerticalAlignment="Center">
                                            <Button Classes="subtle quickInstall" IsVisible="{Binding ShowQuickInstall}"
                                                    IsEnabled="{Binding !$parent[views:OnlineModsView].((vm:MainWindowViewModel)DataContext).AreModActionsBlocked}"
                                                    Command="{Binding $parent[views:OnlineModsView].((vm:MainWindowViewModel)DataContext).InstallModCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Install]}"/>
                                            <TextBlock Classes="success" FontSize="12" IsVisible="{Binding ShowInstalledState}"
                                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[StateInstalled]}"/>
                                            <TextBlock Classes="accent" FontSize="12" IsVisible="{Binding ShowUpdateState}"
                                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[StateUpdate]}"/>
                                            <StackPanel Spacing="3" MinWidth="56" IsVisible="{Binding IsInstalling}">
                                                <TextBlock Classes="secondary" Text="{Binding DownloadProgress, StringFormat={}{0:0} %}"/>
                                                <ProgressBar Classes="modProgress" Minimum="0" Maximum="100" Value="{Binding DownloadProgress}"/>
                                            </StackPanel>
                                        </Panel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,10">
                <Button Grid.Column="0" Classes="subtle"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PreviousPage]}"
                        Command="{Binding PreviousBrowsePageCommand}"/>
                <StackPanel Grid.Column="1" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding BrowsePageStatus}" HorizontalAlignment="Center" Classes="secondary"/>
                    <ProgressBar IsIndeterminate="True" Width="100" Height="3" IsVisible="{Binding IsBrowseLoading}"/>
                </StackPanel>
                <Button Grid.Column="2" Classes="subtle"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NextPage]}"
                        Command="{Binding NextBrowsePageCommand}"/>
                </Grid>
        </Grid>
    </Grid>
</UserControl>
