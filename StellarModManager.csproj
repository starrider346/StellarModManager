<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
        <LangVersion>Preview</LangVersion>
		<Nullable>enable</Nullable>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<Version>2.5.0</Version>
		<DefaultItemExcludes>$(DefaultItemExcludes);StellarModManager.Tests/**</DefaultItemExcludes>
		<StellarModsApiOrigin Condition="'$(StellarModsApiOrigin)' == ''">https://localhost:3000</StellarModsApiOrigin>
	</PropertyGroup>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win-')) Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')">
		<OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Assets\icon.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
		<AssemblyMetadata Include="StellarModsApiOrigin" Value="$(StellarModsApiOrigin)" />
		<AssemblyMetadata Include="AppUpdateRepository" Value="$(AppUpdateRepository)" Condition="'$(AppUpdateRepository)' != ''" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Data\Themes\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>

		<None Include="Data\Localization\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.0.5" />
		<PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
		<PackageReference Include="Avalonia.Headless" Version="12.0.5" />
		<PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.0.5" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />

		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>

		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
		<PackageReference Include="Markdig" Version="1.6.0" />

		<PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />

		<PackageReference Include="System.Drawing.Common" Version="10.0.12" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
		<PackageReference Include="Tomlyn" Version="2.10.1" />
	</ItemGroup>

</Project>
